#!/bin/bash
set -e

case "$1" in
    configure)
        if command -v dkms >/dev/null 2>&1; then
            dkms add kblocker/2.0 2>/dev/null || true
            dkms build kblocker/2.0 2>/dev/null || \
                echo "Warning: dkms build failed. Run 'dkms build kblocker/2.0' manually." >&2
            dkms install kblocker/2.0 2>/dev/null || \
                echo "Warning: dkms install failed. Run 'dkms install kblocker/2.0' manually." >&2
        else
            echo "Warning: dkms not found. Module will not auto-build on kernel upgrades." >&2
        fi

        depmod -a

        echo "kblocker" > /etc/modules-load.d/kblocker.conf

        KO_FILE="/lib/modules/$(uname -r)/extra/kblocker.ko"
        if [ -f "$KO_FILE" ] && command -v chattr >/dev/null 2>&1; then
            chattr +i "$KO_FILE" 2>/dev/null || true
        fi

        modprobe kblocker 2>/dev/null || \
            echo "Warning: could not load kblocker module. Reboot or run 'modprobe kblocker'." >&2

        systemctl daemon-reload 2>/dev/null || true
        systemctl enable --now kblocker-scheduler.service 2>/dev/null || true

        # Default block list: social media
        /usr/local/bin/kblockerctl block facebook.com fbcdn.net instagram.com \
            cdninstagram.com x.com twitter.com twimg.com tiktok.com tiktokcdn.com \
            reddit.com redd.it snapchat.com threads.net bsky.app 2>/dev/null || true

        echo "kblocker installed (disabled by default)."
        echo "  kblockerctl enable 60   — block for 60 minutes"
        echo "  kblockerctl disable     — stop blocking"
        echo "  kblockerctl status      — check status"
        ;;
esac