# Merged on top of kernel.config for the race-detection kernel
# (SANITIZER=kcsan). KCSAN depends on !KASAN, so it needs its own build.

# CONFIG_KASAN is not set
CONFIG_KCSAN=y
# Watch in interrupt context too: the netfilter hooks run in softirq and
# race with the sysfs and file-protection paths running in task context
CONFIG_KCSAN_INTERRUPT_WATCHER=y
# Print the locks held by both sides (needs PROVE_LOCKING)
CONFIG_KCSAN_VERBOSE=y
# Default (non-strict) rules: only races that observably change a value
CONFIG_KCSAN_REPORT_VALUE_CHANGE_ONLY=y
CONFIG_KCSAN_REPORT_RACE_UNKNOWN_ORIGIN=y
