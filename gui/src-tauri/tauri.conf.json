{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "kblocker",
  "version": "0.1.0",
  "identifier": "dev.kblocker.gui",
  "build": {
    "beforeDevCommand": "astro dev",
    "devUrl": "http://127.0.0.1:4321",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "kblocker",
        "width": 1120,
        "height": 760,
        "minWidth": 680,
        "minHeight": 520,
        "backgroundColor": "#141414"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png"],
    "category": "Productivity",
    "shortDescription": "Block distracting sites at the kernel level",
    "linux": {
      "deb": { "depends": ["policykit-1", "gnupg"] }
    }
  }
}
