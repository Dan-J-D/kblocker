# Merged on top of x86_64 defconfig + kvm_guest.config for the fuzzing kernel.

# Coverage for syzkaller (applies to out-of-tree modules too)
CONFIG_KCOV=y
CONFIG_KCOV_INSTRUMENT_ALL=y
CONFIG_KCOV_ENABLE_COMPARISONS=y
CONFIG_DEBUG_FS=y

# Bug detectors
CONFIG_KASAN=y
CONFIG_KASAN_INLINE=y
CONFIG_PROVE_LOCKING=y
CONFIG_DEBUG_ATOMIC_SLEEP=y
CONFIG_DEBUG_LIST=y
CONFIG_PROVE_RCU=y
CONFIG_DEBUG_OBJECTS=y
CONFIG_DEBUG_OBJECTS_TIMERS=y
CONFIG_DEBUG_OBJECTS_WORK=y
CONFIG_REFCOUNT_FULL=y
CONFIG_FAULT_INJECTION=y
CONFIG_FAILSLAB=y
CONFIG_FAULT_INJECTION_DEBUG_FS=y
CONFIG_PANIC_ON_OOPS=y

# Symbolized reports
CONFIG_DEBUG_INFO_DWARF4=y
CONFIG_KALLSYMS=y
CONFIG_KALLSYMS_ALL=y

# Required by syzkaller's sandboxing and the Debian image
CONFIG_NAMESPACES=y
CONFIG_USER_NS=y
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
CONFIG_CGROUP_PIDS=y
CONFIG_MEMCG=y
CONFIG_CONFIGFS_FS=y
CONFIG_SECURITYFS=y

# kblocker
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y
CONFIG_NETFILTER=y
CONFIG_IPV6=y
CONFIG_TCP_FASTOPEN=y
CONFIG_EXT4_FS=y
