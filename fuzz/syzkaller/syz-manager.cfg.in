{
	"target": "linux/amd64",
	"http": "127.0.0.1:56741",
	"workdir": "@WORK@/workdir",
	"kernel_obj": "@WORK@/linux",
	"module_obj": ["@WORK@/module"],
	"image": "@WORK@/image/trixie.img",
	"sshkey": "@WORK@/image/trixie.id_rsa",
	"syzkaller": "@WORK@/syzkaller",
	"procs": 1,
	"sandbox": "none",
	"type": "qemu",
	"vm": {
		"count": @VMS@,
		"kernel": "@WORK@/linux/arch/x86/boot/bzImage",
		"cpu": 2,
		"mem": 2048,
		"cmdline": "net.ifnames=0"
	},
	"enable_syscalls": [
		"openat$kblocker*",
		"read$kblocker",
		"write$kblocker*",
		"sendto$kblocker*",
		"unlink$kblocker",
		"rename$kblocker*",
		"link$kblocker",
		"truncate$kblocker",
		"chmod$kblocker",
		"mount$kblocker_bind",
		"umount2$kblocker",
		"ioctl$FS_IOC_SETFLAGS",
		"ioctl$FS_IOC_FSSETXATTR",
		"socket$inet_tcp",
		"socket$inet6_tcp",
		"socket$inet_udp",
		"socket$inet6_udp",
		"bind$inet",
		"bind$inet6",
		"listen",
		"connect$inet",
		"connect$inet6",
		"accept4$inet",
		"accept4$inet6",
		"setsockopt$inet_tcp_int",
		"setsockopt$inet6_tcp_int",
		"setsockopt$inet6_IPV6_HOPOPTS",
		"setsockopt$inet6_IPV6_DSTOPTS",
		"setsockopt$inet6_IPV6_RTHDR",
		"close"
	]
}
